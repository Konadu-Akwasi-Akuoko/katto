---
source: crates/katto-engine/src/emit/fcpxml/builder.rs
expression: write_document(&tiny_doc()).unwrap()
---
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE fcpxml>
<fcpxml version="1.11">
  <resources>
    <format id="r1" frameDuration="1/25s" width="3840" height="2160" colorSpace="1-1-1 (Rec. 709)"/>
    <asset id="r2" name="clip.mp4" start="0s" duration="10s" hasVideo="1" hasAudio="1" format="r1" audioSources="1" audioChannels="2" audioRate="48000">
      <media-rep kind="original-media" src="file:///a/clip.mp4"/>
    </asset>
  </resources>
  <event name="katto">
    <project name="demo-v1">
      <sequence format="r1" duration="9s" tcStart="0s" tcFormat="NDF" audioLayout="stereo" audioRate="48k">
        <spine>
          <asset-clip ref="r2" offset="0s" name="keep 1" start="0s" duration="9s" audioRole="dialogue">
            <asset-clip ref="r2" lane="-1" offset="4s" name="removed 1" start="4s" duration="1s" enabled="0" audioRole="dialogue"/>
          </asset-clip>
        </spine>
      </sequence>
    </project>
  </event>
</fcpxml>
